table Songs

	column track_id
		dataType: int64
		summarizeBy: none
		sourceColumn: track_id

	column track_name
		dataType: string
		summarizeBy: none
		sourceColumn: track_name

	column artist_name
		dataType: string
		summarizeBy: none
		sourceColumn: artist_name

	column artist_count
		dataType: int64
		summarizeBy: none
		sourceColumn: artist_count

	column released_year
		dataType: int64
		summarizeBy: none
		sourceColumn: released_year

	column released_month
		dataType: int64
		summarizeBy: none
		sourceColumn: released_month

	column released_day
		dataType: int64
		summarizeBy: none
		sourceColumn: released_day

	column release_date
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: release_date

	column in_spotify_playlists
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: in_spotify_playlists

	column in_spotify_charts
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: in_spotify_charts

	column streams
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: streams

	column in_apple_playlists
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: in_apple_playlists

	column in_apple_charts
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: in_apple_charts

	column in_deezer_playlists
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: in_deezer_playlists

	column in_deezer_charts
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: in_deezer_charts

	column in_shazam_charts
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: in_shazam_charts

	column bpm
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: bpm

	column key
		dataType: string
		summarizeBy: none
		sourceColumn: key

	column mode
		dataType: string
		summarizeBy: none
		sourceColumn: mode

	column danceability_pct
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: danceability_pct

	column valence_pct
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: valence_pct

	column energy_pct
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: energy_pct

	column acousticness_pct
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: acousticness_pct

	column instrumentalness_pct
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: instrumentalness_pct

	column liveness_pct
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: liveness_pct

	column speechiness_pct
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: speechiness_pct

	column shazam_value_missing
		dataType: string
		summarizeBy: none
		sourceColumn: shazam_value_missing

	column xplat_score
		dataType: double
		formatString: 0.0
		summarizeBy: average
		sourceColumn: xplat_score

	column 'Total Playlists' = Songs[in_spotify_playlists] + Songs[in_apple_playlists] + Songs[in_deezer_playlists]
		dataType: int64
		formatString: #,0
		summarizeBy: sum

	column 'Chart Score Sum' = Songs[in_spotify_charts] + Songs[in_apple_charts] + Songs[in_deezer_charts] + Songs[in_shazam_charts]
		dataType: int64
		formatString: #,0
		summarizeBy: sum

	column 'Platforms Charted' = IF(Songs[in_spotify_charts] > 0, 1, 0) + IF(Songs[in_apple_charts] > 0, 1, 0) + IF(Songs[in_deezer_charts] > 0, 1, 0) + IF(Songs[in_shazam_charts] > 0, 1, 0)
		dataType: int64
		summarizeBy: none

	column 'Log Streams' = LOG10(Songs[streams])
		dataType: double
		formatString: 0.000
		summarizeBy: none

	column 'Log Playlists' = LOG10(Songs[Total Playlists] + 1)
		dataType: double
		formatString: 0.000
		summarizeBy: none

	column Era = SWITCH(TRUE(), Songs[released_year] < 2020, "1 Pre-2020", Songs[released_year] < 2023, "2 2020-2022", "3 2023")
		dataType: string
		summarizeBy: none

	column 'Playlist Quartile' = SWITCH(TRUE(), Songs[in_spotify_playlists] <= 874.5, "Q1 (fewest)", Songs[in_spotify_playlists] <= 2216.5, "Q2", Songs[in_spotify_playlists] <= 5682.75, "Q3", "Q4 (most)")
		dataType: string
		summarizeBy: none

	column 'Stream Quartile' = SWITCH(TRUE(), Songs[streams] <= 141636175, "Q1 (lowest)", Songs[streams] <= 289165138.5, "Q2", Songs[streams] <= 672942469, "Q3", "Q4 (highest)")
		dataType: string
		summarizeBy: none

	column 'Spotify Chart Tier' = SWITCH(TRUE(), Songs[in_spotify_charts] = 0, "1 Not charted", Songs[in_spotify_charts] <= 7, "2 Low", Songs[in_spotify_charts] <= 23, "3 Mid", "4 High")
		dataType: string
		summarizeBy: none

	column 'Apple Chart Tier' = SWITCH(TRUE(), Songs[in_apple_charts] = 0, "1 Not charted", Songs[in_apple_charts] <= 21, "2 Low", Songs[in_apple_charts] <= 78, "3 Mid", "4 High")
		dataType: string
		summarizeBy: none

	column 'Deezer Chart Tier' = SWITCH(TRUE(), Songs[in_deezer_charts] = 0, "1 Not charted", Songs[in_deezer_charts] <= 1, "2 Low", Songs[in_deezer_charts] <= 6, "3 Mid", "4 High")
		dataType: string
		summarizeBy: none

	column 'Shazam Chart Tier' = SWITCH(TRUE(), Songs[in_shazam_charts] = 0, "1 Not charted", Songs[in_shazam_charts] <= 8, "2 Low", Songs[in_shazam_charts] <= 55, "3 Mid", "4 High")
		dataType: string
		summarizeBy: none

	column 'Danceability Bin' = FORMAT(FLOOR(Songs[danceability_pct], 10), "000") & "-" & FORMAT(FLOOR(Songs[danceability_pct], 10) + 9, "000")
		dataType: string
		summarizeBy: none

	column 'Energy Bin' = FORMAT(FLOOR(Songs[energy_pct], 10), "000") & "-" & FORMAT(FLOOR(Songs[energy_pct], 10) + 9, "000")
		dataType: string
		summarizeBy: none

	column 'Valence Bin' = FORMAT(FLOOR(Songs[valence_pct], 10), "000") & "-" & FORMAT(FLOOR(Songs[valence_pct], 10) + 9, "000")
		dataType: string
		summarizeBy: none

	column 'BPM Bin' = FORMAT(FLOOR(Songs[bpm], 20), "000") & "-" & FORMAT(FLOOR(Songs[bpm], 20) + 19, "000")
		dataType: string
		summarizeBy: none

	column Residual = Songs[Log Streams] - (0.6760452166129375 * Songs[Log Playlists] + 6.188070285154989)
		dataType: double
		formatString: 0.000
		summarizeBy: none

	column 'Residual Z' = DIVIDE(Songs[Residual], 0.3058375829206085)
		dataType: double
		formatString: 0.00
		summarizeBy: none

	column 'Outlier Group' = SWITCH(TRUE(), Songs[Residual Z] > 1.5, "Over-performer", Songs[Residual Z] < -1.5, "Under-performer", "Typical")
		dataType: string
		summarizeBy: none

	measure 'Songs Count' = DISTINCTCOUNT(Songs[track_id])
		formatString: #,0
		displayFolder: KPIs

	measure 'Total Streams' = SUM(Songs[streams])
		formatString: #,0
		displayFolder: KPIs

	measure 'Total Streams (bn)' = DIVIDE([Total Streams], 1000000000)
		formatString: 0.0"bn"
		displayFolder: KPIs

	measure 'Avg Streams' = AVERAGE(Songs[streams])
		formatString: #,0
		displayFolder: KPIs

	measure 'Median Streams' = MEDIAN(Songs[streams])
		formatString: #,0
		displayFolder: KPIs

	measure 'Median Streams (M)' = DIVIDE([Median Streams], 1000000)
		formatString: 0.0"M"
		displayFolder: KPIs

	measure 'Unique Artists' = DISTINCTCOUNT(ArtistSongs[artist_name])
		formatString: #,0
		displayFolder: KPIs

	measure 'Avg BPM' = AVERAGE(Songs[bpm])
		formatString: 0.0
		displayFolder: Audio

	measure 'Avg Danceability' = AVERAGE(Songs[danceability_pct])
		formatString: 0.0
		displayFolder: Audio

	measure 'Avg Energy' = AVERAGE(Songs[energy_pct])
		formatString: 0.0
		displayFolder: Audio

	measure 'Avg Valence' = AVERAGE(Songs[valence_pct])
		formatString: 0.0
		displayFolder: Audio

	measure 'Avg Acousticness' = AVERAGE(Songs[acousticness_pct])
		formatString: 0.0
		displayFolder: Audio

	measure 'Avg Speechiness' = AVERAGE(Songs[speechiness_pct])
		formatString: 0.0
		displayFolder: Audio

	measure 'Corr Danceability vs Valence' = ```
			VAR t = ALLSELECTED(Songs)
			VAR mx = AVERAGEX(t, Songs[danceability_pct])
			VAR my = AVERAGEX(t, Songs[valence_pct])
			VAR num = SUMX(t, (Songs[danceability_pct] - mx) * (Songs[valence_pct] - my))
			VAR dx = SUMX(t, (Songs[danceability_pct] - mx) ^ 2)
			VAR dy = SUMX(t, (Songs[valence_pct] - my) ^ 2)
			RETURN DIVIDE(num, SQRT(dx * dy))
			```
		formatString: 0.00
		displayFolder: Audio

	measure 'Corr Energy vs Acousticness' = ```
			VAR t = ALLSELECTED(Songs)
			VAR mx = AVERAGEX(t, Songs[energy_pct])
			VAR my = AVERAGEX(t, Songs[acousticness_pct])
			VAR num = SUMX(t, (Songs[energy_pct] - mx) * (Songs[acousticness_pct] - my))
			VAR dx = SUMX(t, (Songs[energy_pct] - mx) ^ 2)
			VAR dy = SUMX(t, (Songs[acousticness_pct] - my) ^ 2)
			RETURN DIVIDE(num, SQRT(dx * dy))
			```
		formatString: 0.00
		displayFolder: Audio

	measure 'Corr Playlists vs Streams (log)' = ```
			VAR t = ALLSELECTED(Songs)
			VAR mx = AVERAGEX(t, Songs[Log Playlists])
			VAR my = AVERAGEX(t, Songs[Log Streams])
			VAR num = SUMX(t, (Songs[Log Playlists] - mx) * (Songs[Log Streams] - my))
			VAR dx = SUMX(t, (Songs[Log Playlists] - mx) ^ 2)
			VAR dy = SUMX(t, (Songs[Log Streams] - my) ^ 2)
			RETURN DIVIDE(num, SQRT(dx * dy))
			```
		formatString: 0.00
		displayFolder: Playlists

	measure '% Charted Spotify' = DIVIDE(CALCULATE([Songs Count], Songs[in_spotify_charts] > 0), [Songs Count])
		formatString: 0.0%
		displayFolder: Platforms

	measure '% Charted Apple Music' = DIVIDE(CALCULATE([Songs Count], Songs[in_apple_charts] > 0), [Songs Count])
		formatString: 0.0%
		displayFolder: Platforms

	measure '% Charted Deezer' = DIVIDE(CALCULATE([Songs Count], Songs[in_deezer_charts] > 0), [Songs Count])
		formatString: 0.0%
		displayFolder: Platforms

	measure '% Charted Shazam' = DIVIDE(CALCULATE([Songs Count], Songs[in_shazam_charts] > 0), [Songs Count])
		formatString: 0.0%
		displayFolder: Platforms

	measure '% On All 4 Platforms' = DIVIDE(CALCULATE([Songs Count], Songs[Platforms Charted] = 4), [Songs Count])
		formatString: 0.0%
		displayFolder: Platforms

	measure 'Avg Cross-Platform Score' = AVERAGE(Songs[xplat_score])
		formatString: 0.0
		displayFolder: Platforms

	measure 'Sum Total Playlists' = SUM(Songs[Total Playlists])
		formatString: #,0
		displayFolder: Playlists

	measure 'Sum Spotify Playlists' = SUM(Songs[in_spotify_playlists])
		formatString: #,0
		displayFolder: Playlists

	measure 'Sum Spotify Charts' = SUM(Songs[in_spotify_charts])
		formatString: #,0
		displayFolder: Charts

	measure 'Sum Apple Charts' = SUM(Songs[in_apple_charts])
		formatString: #,0
		displayFolder: Charts

	measure 'Sum Deezer Charts' = SUM(Songs[in_deezer_charts])
		formatString: #,0
		displayFolder: Charts

	measure 'Sum Shazam Charts' = SUM(Songs[in_shazam_charts])
		formatString: #,0
		displayFolder: Charts

	measure 'Sum Chart Score' = SUM(Songs[Chart Score Sum])
		formatString: #,0
		displayFolder: Charts

	measure 'Avg Residual Z' = AVERAGE(Songs[Residual Z])
		formatString: 0.00
		displayFolder: Outliers

	measure Over-performers = CALCULATE([Songs Count], Songs[Outlier Group] = "Over-performer")
		formatString: #,0
		displayFolder: Outliers

	measure Under-performers = CALCULATE([Songs Count], Songs[Outlier Group] = "Under-performer")
		formatString: #,0
		displayFolder: Outliers

	partition Songs = m
		mode: import
		source =
			let
				Source = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)),
				Rows = Table.FromRows(Source, {"track_id", "track_name", "artist_name", "artist_count", "released_year", "released_month", "released_day", "release_date", "in_spotify_playlists", "in_spotify_charts", "streams", "in_apple_playlists", "in_apple_charts", "in_deezer_playlists", "in_deezer_charts", "in_shazam_charts", "bpm", "key", "mode", "danceability_pct", "valence_pct", "energy_pct", "acousticness_pct", "instrumentalness_pct", "liveness_pct", "speechiness_pct", "shazam_value_missing", "xplat_score"}),
				Typed = Table.TransformColumnTypes(Rows, {{"track_id", Int64.Type}, {"track_name", type text}, {"artist_name", type text}, {"artist_count", Int64.Type}, {"released_year", Int64.Type}, {"released_month", Int64.Type}, {"released_day", Int64.Type}, {"release_date", type date}, {"in_spotify_playlists", Int64.Type}, {"in_spotify_charts", Int64.Type}, {"streams", Int64.Type}, {"in_apple_playlists", Int64.Type}, {"in_apple_charts", Int64.Type}, {"in_deezer_playlists", Int64.Type}, {"in_deezer_charts", Int64.Type}, {"in_shazam_charts", Int64.Type}, {"bpm", Int64.Type}, {"key", type text}, {"mode", type text}, {"danceability_pct", Int64.Type}, {"valence_pct", Int64.Type}, {"energy_pct", Int64.Type}, {"acousticness_pct", Int64.Type}, {"instrumentalness_pct", Int64.Type}, {"liveness_pct", Int64.Type}, {"speechiness_pct", Int64.Type}, {"shazam_value_missing", type text}, {"xplat_score", type number}}, "en-US")
			in
				Typed

