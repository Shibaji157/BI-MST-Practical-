table ArtistSongs

	column artist_name
		dataType: string
		summarizeBy: none
		sourceColumn: artist_name

	column track_id
		dataType: int64
		summarizeBy: none
		sourceColumn: track_id

	column streams
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: streams

	measure 'Artist Streams' = SUM(ArtistSongs[streams])
		formatString: #,0
		displayFolder: Pareto

	measure 'Artist Songs' = DISTINCTCOUNT(ArtistSongs[track_id])
		formatString: #,0
		displayFolder: Pareto

	measure 'Top N Value' = SELECTEDVALUE('Top N'[Top N], 25)
		formatString: 0
		displayFolder: Pareto

	measure 'Artist Rank' = RANKX(ALLSELECTED(ArtistSongs[artist_name]), [Artist Streams], , DESC, Dense)
		formatString: 0
		displayFolder: Pareto

	measure 'Total Artist Streams' = CALCULATE([Artist Streams], ALLSELECTED(ArtistSongs[artist_name]))
		formatString: #,0
		displayFolder: Pareto

	measure '% Contribution' = DIVIDE([Artist Streams], [Total Artist Streams])
		formatString: 0.00%
		displayFolder: Pareto

	measure 'Cumulative Streams' = ```
			VAR r = [Artist Rank]
			RETURN SUMX(FILTER(ALLSELECTED(ArtistSongs[artist_name]), [Artist Rank] <= r), [Artist Streams])
			```
		formatString: #,0
		displayFolder: Pareto

	measure 'Cumulative %' = DIVIDE([Cumulative Streams], [Total Artist Streams])
		formatString: 0.0%
		displayFolder: Pareto

	measure 'Artist Streams (Top N)' = IF([Artist Rank] <= [Top N Value], [Artist Streams])
		formatString: #,0
		displayFolder: Pareto

	measure 'Cumulative % (Top N)' = IF([Artist Rank] <= [Top N Value], [Cumulative %])
		formatString: 0.0%
		displayFolder: Pareto

	measure '% Contribution (Top N)' = IF([Artist Rank] <= [Top N Value], [% Contribution])
		formatString: 0.00%
		displayFolder: Pareto

	measure 'Artists to Reach 80%' = COUNTROWS(FILTER(ALLSELECTED(ArtistSongs[artist_name]), [Cumulative %] <= 0.8)) + 1
		formatString: #,0
		displayFolder: Pareto

	measure '% of Artists to Reach 80%' = DIVIDE([Artists to Reach 80%], [Unique Artists])
		formatString: 0.0%
		displayFolder: Pareto

	measure 'Top 10% Artists Share' = ```
			VAR n = ROUNDDOWN(0.1 * [Unique Artists], 0)
			RETURN DIVIDE(SUMX(FILTER(ALLSELECTED(ArtistSongs[artist_name]), [Artist Rank] <= n), [Artist Streams]), [Total Artist Streams])
			```
		formatString: 0.0%
		displayFolder: Pareto

	measure 'Top 20% Artists Share' = ```
			VAR n = ROUNDDOWN(0.2 * [Unique Artists], 0)
			RETURN DIVIDE(SUMX(FILTER(ALLSELECTED(ArtistSongs[artist_name]), [Artist Rank] <= n), [Artist Streams]), [Total Artist Streams])
			```
		formatString: 0.0%
		displayFolder: Pareto

	partition ArtistSongs = m
		mode: import
		source =
			let
				Source = Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)),
				Rows = Table.FromRows(Source, {"artist_name", "track_id", "streams"}),
				Typed = Table.TransformColumnTypes(Rows, {{"artist_name", type text}, {"track_id", Int64.Type}, {"streams", Int64.Type}}, "en-US")
			in
				Typed

